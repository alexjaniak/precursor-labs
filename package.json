{
  "name": "liquid-dot-logo-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.13.1",
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "contact:dev": "wrangler dev --config worker/wrangler.toml",
    "contact:deploy": "wrangler deploy --config worker/wrangler.toml",
    "contact:secret:slack": "wrangler secret put SLACK_WEBHOOK_URL --config worker/wrangler.toml",
    "contact:secret:turnstile": "wrangler secret put TURNSTILE_SECRET_KEY --config worker/wrangler.toml",
    "export:svg": "tsx scripts/export-default-svg.mts",
    "export:svg:transparent": "tsx scripts/export-default-svg.mts --transparent",
    "export:banner": "tsx scripts/export-banner-svg.mts",
    "export:launch-banner": "tsx scripts/export-launch-x-banner.mts",
    "export:banner:transparent": "tsx scripts/export-banner-svg.mts --transparent",
    "build": "pnpm run check && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "fast-xml-parser": "^5.11.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "mixpanel-browser": "^2.81.0"
  }
}
