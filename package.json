{
  "name": "liquid-dot-logo-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.13.1",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "export:svg": "tsx scripts/export-default-svg.mts",
    "export:svg:transparent": "tsx scripts/export-default-svg.mts --transparent",
    "export:banner": "tsx scripts/export-banner-svg.mts",
    "export:launch-banner": "tsx scripts/export-launch-x-banner.mts",
    "export:banner:transparent": "tsx scripts/export-banner-svg.mts --transparent",
    "build": "pnpm run check && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "mixpanel-browser": "^2.81.0"
  }
}
